# LiteLLM SDK mode is the default. Set the provider credential on the server.
LITELLM_GATEWAY_MODE=sdk
LITELLM_MODEL=groq/openai/gpt-oss-20b
GROQ_API_KEY=replace-with-your-server-side-groq-key
LITELLM_FALLBACK_MODELS=
LITELLM_TIMEOUT=30
LITELLM_CONNECT_TIMEOUT=10
LITELLM_MAX_RETRIES=2
LITELLM_MAX_OUTPUT_TOKENS=2048
LITELLM_MAX_CONCURRENT_REQUESTS=10
LITELLM_ENABLE_COST_TRACKING=false

# Optional LiteLLM Proxy mode. Configure a real URL and virtual key when enabled.
# LITELLM_GATEWAY_MODE=proxy
# LITELLM_PROXY_URL=https://litellm-proxy.example.com
# LITELLM_PROXY_API_KEY=replace-with-your-server-side-proxy-key

# Agent and request limits.
AGENT_MAX_INPUT_CHARS=2000
AGENT_MAX_HISTORY_MESSAGES=12
AGENT_MAX_CONTEXT_TOKENS=6000
AGENT_MAX_TOTAL_CONTEXT_TOKENS=12000
AGENT_RESERVED_SYSTEM_TOKENS=2000
AGENT_MAX_GRAPH_ITERATIONS=8
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_RAG_SEARCHES=3
AGENT_MAX_RETRIEVED_CHUNKS=5
AGENT_MAX_RETRIEVED_CONTEXT_TOKENS=4000
AGENT_MAX_QUERY_CHARS=2000
AGENT_MAX_TOOL_DURATION_SECONDS=20
AGENT_MAX_OUTPUT_CHARS=12000
API_REQUEST_TIMEOUT_SECONDS=180
API_MAX_CONCURRENT_CHATS=10
API_RATE_LIMIT_REQUESTS=20
API_RATE_LIMIT_WINDOW_SECONDS=60
PII_MODE=off
LOG_LEVEL=INFO

# Production requires Redis for a rate limit shared between workers/instances.
# APP_ENV=production
# REDIS_URL=redis://localhost:6379/0

# Existing Azure AI Search and embedding configuration.
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=replace-with-your-server-side-search-key
AZURE_SEARCH_INDEX=sharepoint-documents
AZURE_SEARCH_TIMEOUT_SECONDS=15
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
